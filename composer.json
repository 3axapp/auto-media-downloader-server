{
    "name": "zakharov/auto-media-downloader-server",
    "description": "Демон-наблюдатель за релизами LostFilm",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "react/event-loop": "^1.6",
        "react/http": "^1.11",
        "react/promise": "^3.3",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Zakharov\\AutoMediaDownloaderServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zakharov\\AutoMediaDownloaderServer\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Zakharov A.",
            "email": "pro@0x3a.xyz"
        }
    ]
}
